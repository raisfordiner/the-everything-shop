@startuml
!theme plain
title Order: History Sequence

actor "Customer" as User
participant "OrderController" as OrderCtrl
participant "OrderService" as OrderService
participant "Order (DB)" as OrderDB

User -> OrderCtrl : GET /orders
activate OrderCtrl

OrderCtrl -> OrderService : find(customerId)
activate OrderService

OrderService -> OrderDB : findMany(where: customerId, orderBy: date desc)
activate OrderDB
OrderDB --> OrderService : orderList
deactivate OrderDB

OrderService --> OrderCtrl : orderList
deactivate OrderService

OrderCtrl --> User : 200 OK
deactivate OrderCtrl

@enduml
