@startuml
!theme plain
title Auth: Reset Password Sequence

actor "User" as User
participant "AuthController" as AuthCtrl
participant "AuthService" as AuthService
participant "User (DB)" as UserDB

User -> AuthCtrl : POST /auth/reset-password (token, newPassword)
activate AuthCtrl

AuthCtrl -> AuthService : resetPasswordWithToken(token, newPassword)
activate AuthService

AuthService -> AuthService : verifyToken(token)
AuthService -> AuthService : hashPassword(newPassword)

AuthService -> UserDB : update(password: newHash, emailVerified: now)
activate UserDB
UserDB --> AuthService : updatedUser
deactivate UserDB

AuthService -> AuthService : logout(userId) (Invalidate sessions)

AuthService --> AuthCtrl : success
deactivate AuthService

AuthCtrl --> User : 200 OK
deactivate AuthCtrl

@enduml
