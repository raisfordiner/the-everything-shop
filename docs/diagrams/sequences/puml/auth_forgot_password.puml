@startuml
!theme plain
title Auth: Forgot Password Sequence

actor "User" as User
participant "AuthController" as AuthCtrl
participant "AuthService" as AuthService
participant "User (DB)" as UserDB
participant "EmailService" as Email

User -> AuthCtrl : POST /auth/forgot-password (email)
activate AuthCtrl

AuthCtrl -> AuthService : forgotPassword(email)
activate AuthService

AuthService -> UserDB : findUnique(email)
activate UserDB
UserDB --> AuthService : user
deactivate UserDB

alt User Exists
    AuthService -> AuthService : generateResetToken()
    AuthService --> AuthCtrl : {user, token}
    
    AuthCtrl -> Email : sendResetEmail(email, token)
    activate Email
    Email --> AuthCtrl : success
    deactivate Email
else User Not Found
    AuthService --> AuthCtrl : {null, null}
end

AuthCtrl --> User : 200 OK (Generic Success Message)
deactivate AuthCtrl

@enduml
